# Testno okolje za funkcionalne teste. Vse vrednosti so namenoma lažne: testi ne uporabljajo
# pravih storitev (Firebase Auth teče v emulatorju, MongoDB je ločena baza *_e2e).

# Ločena testna baza; testi jo pred in po vsakem testu izpraznijo.
MONGODB_URI=mongodb://127.0.0.1:27017/careercompass_e2e

# Naslova aplikacije v testih (ločena vrata, da se ne pomešata z razvojnima strežnikoma).
E2E_BASE_URL=http://localhost:3100
E2E_FRONTEND_PORT=3100
E2E_BACKEND_PORT=4100

# Obličje: produkcijska gradnja v ločeno mapo .next-e2e, ki kliče zaledje na :4100.
NODE_ENV=production
NEXT_DIST_DIR=.next-e2e
NEXT_PUBLIC_API_URL=http://localhost:4100
NEXTAUTH_URL=http://localhost:3100
NEXT_PUBLIC_SITE_URL=http://localhost:3100
SECRET=e2e-only-nextauth-secret

# Firebase Auth emulator (projekti z imenom demo-* ne potrebujejo pravega Firebase projekta).
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIREBASE_PROJECT_ID=demo-careercompass
FIREBASE_API_KEY=demo-api-key
FIREBASE_AUTH_DOMAIN=demo-careercompass.firebaseapp.com
FIREBASE_STORAGE_BUCKET=demo-careercompass.appspot.com
FIREBASE_MESSAGING_SENDER_ID=000000000000
FIREBASE_APP_ID=1:000000000000:web:e2e

# Zaledje ob zagonu ustvari OpenAI odjemalca; testirane funkcionalnosti ga ne kličejo.
OPENAI_API_KEY=e2e-not-used
